#!/bin/bash
set -Eeuo pipefail

LOG_DIR="var/log"
LOG_FILE="$LOG_DIR/search.log"
FLASK_CMD="flask --app search run --host 0.0.0.0 --port 8000"

start_server() {
  echo "starting search server ..."

  mkdir -p "$LOG_DIR"

  if [ ! -f "var/search.sqlite3" ]; then
    echo "Error: can't find search database var/search.sqlite3"
    echo "Try: ./bin/searchdb"
    exit 1
  fi

  ./bin/index status
  if [ $? -ne 0 ]; then
    echo "Error: index server is not running"
    exit 1
  fi

  if pgrep -f "$FLASK_CMD" > /dev/null; then
    echo "Search server is already running"
    exit 1
  fi

  rm -f "$LOG_FILE"
  echo "+ $FLASK_CMD &> $LOG_FILE &"
  $FLASK_CMD &> "$LOG_FILE" &
}

stop_server() {
  echo "stopping search server ..."
  pkill -f "$FLASK_CMD" || true
}

status_server() {
  set +o pipefail
  NPROCS=$(pgrep -f "$FLASK_CMD" | wc -l)
  set -o pipefail
  if [ "$NPROCS" -eq 1 ]; then
    echo "search server running"
    exit 0
  elif [ "$NPROCS" -eq 0 ]; then
    echo "search server stopped"
    exit 1
  else
    echo "search server error: found ${NPROCS} processes, expected 1"
    exit 2
  fi
}

case "$1" in
  start)
    start_server
    ;;
  stop)
    stop_server
    ;;
  status)
    status_server
    ;;
  restart)
    stop_server
    start_server
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart}"
    exit 1
    ;;
esac