#!/bin/bash
LOG_DIR="var/log"
LOG_FILE="$LOG_DIR/search.log"
SEARCH_DB="var/search.sqlite3"
SEARCH_PORT=8000
SEARCH_PROCESS="flask --app search run --host 0.0.0.0 --port $SEARCH_PORT"

set -Eeuo pipefail

# Check if arguments are provided
if [ $# -eq 0 ]; then
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
fi

function start_search() {
    if [ ! -f "$SEARCH_DB" ]; then
        echo "Error: can't find search database $SEARCH_DB"
        exit 1
    fi

    ./bin/index status > /dev/null
    if [ $? -ne 0 ]; then
        echo "Error: index server is not running"
        echo "Try ./bin/index start"
        exit 1
    fi

    pgrep -f "$SEARCH_PROCESS" > /dev/null
    if [ $? -eq 0 ]; then
        echo "Error: search server is already running"
        exit 1
    fi

    # Start the Search server
    echo "starting search server ..."
    mkdir -p "$LOG_DIR"
    rm -f "$LOG_FILE"
    flask --app search run --host 0.0.0.0 --port $SEARCH_PORT &> "$LOG_FILE" &

}

function stop_search() {
    echo "stopping search server ..."
    pkill -f "$SEARCH_PROCESS" || true
}

function restart_search() {
    stop_search
    start_search
}

function status_search() {
    pgrep -f "$SEARCH_PROCESS" > /dev/null
    if [ $? -eq 0 ]; then
        echo "search server running"
        exit 0
    else
        echo "search server stopped"
        exit 1
    fi
}

case "$1" in
    start)
        start_search
        ;;
    stop)
        stop_search
        ;;
    restart)
        restart_search
        ;;
    status)
        status_search
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
